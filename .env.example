# EDEN — dialogue configuration, for LOCAL DEVELOPMENT ONLY.
#
# The deployed game does not use this file. On Vercel these are project
# environment variables, and OPENAI_API_KEY is stored there as a Sensitive
# variable — nothing needs to be configured by hand to play the deployed build.
#
# This file exists so a developer can run the same endpoint locally. Copy it to
# `.env` and fill in. `.env` is git-ignored and is read only by the dialogue
# server process (server/dialogue.mjs), never by the browser bundle.
#
# EDEN is fully playable with none of this set: the conversation system falls
# back to its own deterministic dialogue, which is the default in any case.

# Your OpenAI API key. Server-side only — never prefix this with VITE_, and
# never let it reach anything under src/.
OPENAI_API_KEY=

# Which model answers. Changing this needs no code change anywhere in the game.
OPENAI_DIALOGUE_MODEL=gpt-4o-mini

# Where the dialogue server listens. Vite proxies /api to this in development.
EDEN_DIALOGUE_PORT=8787

# How long the server waits on OpenAI before giving up and letting the game
# speak for itself. Kept below the deployed platform's function limit, so the
# endpoint answers "no turn" honestly instead of being killed mid-request.
EDEN_DIALOGUE_TIMEOUT_MS=9000
